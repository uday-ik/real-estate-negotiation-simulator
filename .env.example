# ─── Real Estate Negotiation Simulator — Environment Variables ─────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env to git (it's already in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ─── OpenAI API Key ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── GitHub Token (for one demo only) ─────────────────────────────
# Required for: python d1_mcp/github_agent_client.py
# A Personal Access Token on YOUR OWN GitHub account - nothing to do with this repo.
# Create one at https://github.com/settings/tokens
#   Generate new token (classic) -> tick `public_repo` -> copy the ghp_... value
# Leave blank if you are not running that demo; nothing else needs it.
GITHUB_TOKEN=ghp_your-github-token-here

# ─── Agent Model ─────────────────────────────────────────────────────────────
# Change to openai/gpt-4o-mini for cheaper runs (default: openai/gpt-4o)
# AGENT_MODEL=openai/gpt-4o
